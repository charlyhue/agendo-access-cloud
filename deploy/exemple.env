# Configuration d'exemple du plan de contrôle (Dokploy → application → Environment).
#
# Domaines TEMPORAIRES choisis par la personne (trois maisons à elle) : ils changeront. Le code
# n'en contient aucun ; seuls ce fichier et docs/deploy.md les citent.
# Aucun secret ici : les secrets sont des fichiers montés (Dokploy → Advanced → Mounts), dont
# ces variables `…_FILE` donnent le chemin. Vérifié par tests/example_config.rs.

AGENDO_CLOUD_LISTEN=0.0.0.0:8080

# Plan de contrôle (API des maisons, `iss` des jetons) et portail (RP ID WebAuthn = son hôte).
AGENDO_CLOUD_API_URL=https://agendo-api.charly-hue.fr
AGENDO_CLOUD_PORTAL_URL=https://agendo-account.charly-hue.fr

# Zone des maisons : <id>.agendo.charly-hue.fr (dans la zone Cloudflare charly-hue.fr en V1).
AGENDO_CLOUD_ZONE=agendo.charly-hue.fr

# Listes renvoyées aux maisons ; en V1, seulement les relais -1. Ajouter un relais :
# tls://agendo-relay-2.charly-hue.fr, https://agendo-push-2.charly-hue.fr, séparés par des virgules.
AGENDO_CLOUD_RELAYS=tls://agendo-relay-1.charly-hue.fr
AGENDO_CLOUD_PUSH_URLS=https://agendo-push-1.charly-hue.fr

# Secrets (fichiers montés).
AGENDO_CLOUD_DATABASE_URL_FILE=/run/secrets/database-url
AGENDO_CLOUD_SIGNING_KEY_FILE=/run/secrets/signing-key
AGENDO_CLOUD_SIGNING_KID=k1
# Anciennes clés encore publiées pendant une rotation (vide hors rotation).
AGENDO_CLOUD_PUBLISHED_KEYS=

# Courrier : expéditeur sur un domaine vérifié chez Resend (adresse à adapter).
AGENDO_CLOUD_MAILER=resend
AGENDO_CLOUD_MAIL_FROM=Agendo Access <ne-pas-repondre@charly-hue.fr>
AGENDO_CLOUD_RESEND_API_KEY_FILE=/run/secrets/resend-api-key

# DNS-01 : V1 sans délégation, tout dans la zone Cloudflare charly-hue.fr, enregistrements
# « DNS only ». Jeton « Zone → DNS → Edit » sur cette seule zone (docs/deploy.md, section 1).
AGENDO_CLOUD_DNS=cloudflare
AGENDO_CLOUD_CLOUDFLARE_ZONE_ID=identifiant-de-la-zone-charly-hue.fr
AGENDO_CLOUD_CLOUDFLARE_TOKEN_FILE=/run/secrets/dns-token

# Derrière Traefik : IP cliente = dernière entrée de X-Forwarded-For.
AGENDO_CLOUD_TRUST_X_FORWARDED_FOR=true

# Seuils anti-abus (valeurs proposées, aucune valeur par défaut dans le code).
AGENDO_CLOUD_LIMIT_IP_PER_MINUTE=30
AGENDO_CLOUD_LIMIT_EMAIL_CODES_PER_HOUR=5
AGENDO_CLOUD_LIMIT_HOUSE_PER_MINUTE=20
AGENDO_CLOUD_PUSH_PER_HOUR=60
AGENDO_CLOUD_PUSH_CRITICAL_PER_DAY=10

RUST_LOG=info,sqlx=warn
